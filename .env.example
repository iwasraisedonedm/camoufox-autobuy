# Non-sensitive local development defaults only.
AUTOBUY_ENVIRONMENT=local
AUTOBUY_LOG_LEVEL=INFO
AUTOBUY_DATABASE_URL=postgresql+asyncpg://autobuy:autobuy-local@localhost:5432/autobuy
AUTOBUY_REDIS_URL=redis://localhost:6379/0
AUTOBUY_API_HOST=127.0.0.1
AUTOBUY_API_PORT=8000

# Set real service secrets only in ignored local files or a production secrets manager.
# AUTOBUY_INTERNAL_SERVICE_TOKEN=
